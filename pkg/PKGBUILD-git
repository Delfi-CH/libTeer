pkgname=libTeer-git
pkgver=1
pkgrel=1
pkgdesc="Library for handleing tarballs"
arch=('x86_64')
url="https://github.com/Delfi-CH/libTeer"
license=('LGPL-2.1-only')
depends=('glibc' 'zlib' 'xz' 'bzip2' 'zstd')
makedepends=('git' 'gcc' 'make')
provides=('libTeer')
conflicts=('libTeer')

source=("git+https://github.com/Delfi-CH/libTeer.git#branch=main")
sha256sums=('SKIP')

pkgver() {
    cd "$pkgname"
    printf 'r%s.%s' \
        "$(git rev-list --count HEAD)" \
        "$(git rev-parse --short HEAD)"
}

build() {
    cd "$pkgname"
    make OUTPUT=shared CC=gcc
}

package() {
    cd "$pkgname"
    make install DESTDIR="$pkgdir"
    install -Dm 644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}